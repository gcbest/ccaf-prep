{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcbest.github.io/ccaf-prep/learning-graph/schema/topics.schema.json",
  "title": "Micro-topics",
  "type": "object",
  "required": ["topics"],
  "properties": {
    "$comment": { "type": "string" },
    "subject": { "type": "string" },
    "sourceSection": { "type": "string" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/topic" }
    }
  },
  "$defs": {
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "cluster", "name", "description", "evidence", "assessmentPrompt"],
      "properties": {
        "id": { "type": "string", "pattern": "^mt_[a-z0-9_]+$" },
        "type": { "enum": ["CONCEPTUAL", "PROCEDURAL", "FACTUAL"] },
        "cluster": { "type": "string", "pattern": "^cl_[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 3 },
        "description": { "type": "string", "minLength": 20 },
        "core": {
          "type": "boolean",
          "description": "Core topics are prioritised in the task queue: they appear more often as prerequisites, so covering them first buys more practice on them by the end."
        },
        "estMinutes": { "type": "integer", "minimum": 1, "maximum": 60 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Mastery criteria — what a learner must be able to do."
        },
        "assessmentPrompt": { "type": "string" },
        "standards": { "type": "array", "items": { "type": "string" } },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "href"],
            "additionalProperties": false,
            "properties": { "label": { "type": "string" }, "href": { "type": "string" } }
          }
        },
        "centrality": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "Derived. Share of the graph downstream of this topic. Written by scripts/build-web-data.mjs."
        },
        "layer": {
          "type": "integer", "minimum": 0,
          "description": "Derived. Longest chain of hard prerequisites behind this topic."
        }
      }
    }
  }
}
